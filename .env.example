# CampusPulse AI - Environment Configuration Example
# Copy this file to .env or configure these variables in Render Environment settings

# Application Environment & Server Port
NODE_ENV=production
PORT=5000

# Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Persistent Storage Configurations (Optional for Render Persistent Disk / Disk Mount)
# Render Persistent Disk Mount Path Example: /var/data
# DB_PATH=/var/data/campuspulse.db
# UPLOADS_DIR=/var/data/uploads
